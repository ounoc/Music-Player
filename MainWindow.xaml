<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        mc:Ignorable="d"
        Width="1600" Height="900"
        MinWidth="800" MinHeight="600"
        MaxWidth="1600" MaxHeight="900"
        Background="Transparent" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!-- Todos los estilos -->

    <Window.Resources>

        <!-- Boton Redondeado -->

        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#B22E3752"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A7BC8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF2A6BB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boton Redondeado -->

        <!-- Gradiente -->

        <LinearGradientBrush x:Key="Gradiente" StartPoint="1,1" EndPoint="1,0">
            <GradientStop Color="#B2252C40" Offset="0"/>
            <GradientStop Color="#CC0B1129" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gradiente -->

    </Window.Resources>

    <!-- Todos los estilos -->

    <!-- Grid raiz: dos filas -> barra superior (fija) y cuerpo (ocupa el resto) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior -->

        <Border
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            Height="30"
            Margin="0,0,0,0"
            Background="#CC0EA5E9"
            Panel.ZIndex="1"
            CornerRadius="5"
            MouseDown="Border_MouseDown">

            <!-- Donde van los botones-->

            <StackPanel 
                Width="65"
                Height="30"
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <Button
                    HorizontalAlignment="Right"
                    Width="25"
                    Height="25"
                    Margin="5,0,0,0"
                    Content="__"
                    FontSize="15"
                    Click="Minimize"
                    Style="{StaticResource RoundedButton}">

                </Button>

                <Button
                    HorizontalAlignment="Right"
                    Width="25"
                    Height="25"
                    Margin="5,0,0,0"
                    Content="X"
                    FontSize="15"
                    Click="CloseApp"
                    Style="{StaticResource RoundedButton}">

                </Button>

            </StackPanel>

            <!-- Donde van los botones-->

        </Border>

        <!-- Barra Superior -->

        <!-- Cuerpo Principal -->

        <Border
            Grid.Row="1"
            Background="{StaticResource Gradiente}"
            CornerRadius="5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- buscador / config -->
                    <RowDefinition Height="3*"/>
                    <!-- recuadros grandes -->
                    <RowDefinition Height="1*"/>
                    <!-- recuadros de abajo -->
                </Grid.RowDefinitions>

                <!-- Fila buscador + config, en un Grid de 3 columnas para que
                     el buscador quede centrado y Config a la derecha sin
                     importar el ancho de la ventana -->

                <Grid Grid.Row="0" Margin="0,20,0,20" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Buscador -->

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal">

                        <Button
                            Width="40"
                            Height="40"
                            Margin="0,0,30,0"
                            Content="HOME"
                            FontFamily="Nanitos"
                            Foreground="White"
                            Style="{StaticResource RoundedButton}"/>

                        <TextBox
                            VerticalContentAlignment="Center"
                            Background="#B22E3752"
                            Foreground="White"
                            FontFamily="Nanitos"
                            BorderThickness="0"
                            MinWidth="300"
                            Width="500"
                            Height="50"
                            FontSize="20">

                            <TextBox.Resources>

                                <Style TargetType="Border">

                                    <Setter Property="CornerRadius" Value="10"/>

                                </Style>

                            </TextBox.Resources>

                        </TextBox>

                    </StackPanel>

                    <!-- Buscador -->

                    <!-- Config -->

                    <Button
                        Grid.Column="2"
                        Width="50"
                        Height="50"
                        HorizontalAlignment="Right"
                        Content="Config"
                        Foreground="White"
                        FontSize="15"
                        FontFamily="Nanitos"
                        Style="{StaticResource RoundedButton}"/>

                    <!-- Config -->

                </Grid>

                <!-- Recuadros grandes: Grid de 3 columnas proporcionales
                     en vez de StackPanel con anchos fijos 300/700/300 -->

                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2.3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recuadro Izquierda Top -->

                    <Border
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        CornerRadius="20"
                        Background="#B22E3752">



                    </Border>

                    <!-- Recuadro Izquierda Top -->

                    <!-- Recuadro Central Top -->

                    <Border
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        CornerRadius="20"
                        Background="#B22E3752">

                        <!-- Grid de la vista de playlist o discos qsy -->

                        <Grid 
                            x:Name="PlaylistView"
                            Visibility="Hidden">

                            <!-- Identificadores -->

                            <StackPanel 
                                Height="30"
                                Margin="0,5,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">

                                <Label
                                    Width="70"
                                    Height="30"
                                    FontSize="15"
                                    VerticalContentAlignment="Bottom"
                                    Content="Nro°"
                                    Foreground="White"
                                    HorizontalContentAlignment="Center"
                                    FontFamily="Nanitos"/>

                                <Label
                                    Width="300"
                                    Height="30"
                                    FontSize="15"
                                    VerticalContentAlignment="Bottom"
                                    Content="Title"
                                    Margin="20,0,0,0"
                                    Foreground="White"
                                    HorizontalContentAlignment="Center"
                                    FontFamily="Nanitos"/>

                                <Label
                                    Width="150"
                                    Height="30"
                                    FontSize="15"
                                    VerticalContentAlignment="Bottom"
                                    Content="Album"
                                    Margin="20,0,0,0"
                                    Foreground="White"
                                    HorizontalContentAlignment="Center"
                                    FontFamily="Nanitos"/>

                                <Label
                                    Width="70"
                                    Height="30"
                                    FontSize="15"
                                    HorizontalContentAlignment="Center"
                                    Content="Duration"
                                    Margin="20,0,0,0"
                                    Foreground="White"
                                    VerticalContentAlignment="Bottom"
                                    FontFamily="Nanitos"/>

                            </StackPanel>

                            <!-- Identificadores-->

                            <!-- Separador Top -->

                            <StackPanel
                                Height="5"
                                VerticalAlignment="Top"
                                Orientation="Horizontal"
                                Margin="0,40,0,0">

                                <Rectangle
                                    Width="70"
                                    Height="2"
                                    Fill="White"/>

                                <Rectangle
                                    Width="300"
                                    Height="2"
                                    Fill="White"
                                    Margin="20,0,0,0"/>

                                <Rectangle
                                    Width="150"
                                    Height="2"
                                    Fill="White"
                                    Margin="20,0,0,0"/>

                                <Rectangle
                                    Width="70"
                                    Height="2"
                                    Fill="White"
                                    Margin="20,0,0,0"/>

                            </StackPanel>

                            <!-- Separador Top -->

                            <!-- Separador Bot -->

                            <StackPanel
                                Height="5"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Margin="0,0,0,20">

                                <Rectangle
                                    Width="70"
                                    Height="2"
                                    Fill="White"/>

                                <Rectangle
                                    Width="300"
                                    Height="2"
                                    Fill="White"
                                    Margin="20,0,0,0"/>

                                <Rectangle
                                    Width="150"
                                    Height="2"
                                    Fill="White"
                                    Margin="20,0,0,0"/>

                                <Rectangle
                                    Width="70"
                                    Height="2"
                                    Fill="White"
                                    Margin="20,0,0,0"/>

                            </StackPanel>

                            <!-- Separador Bot -->

                            <!-- Contenedor de Canciones -->

                            <ScrollViewer
                                x:Name="Songs_Container"
                                Margin="0,0,0,40"
                                VerticalAlignment="Bottom"
                                VerticalScrollBarVisibility="Auto">

                                <!-- Layout para una cancion (copiar en C#) -->

                                <StackPanel
                                    Height="50"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top"
                                    Background="#19FFFFFF">

                                    <TextBlock
                                        Width="70"
                                        Height="40"
                                        TextAlignment="Center"/>

                                    <TextBlock
                                        Width="300"
                                        Height="40"
                                        Margin="20,0,0,0"
                                        TextAlignment="Left"/>

                                    <Image
                                        Width="40"
                                        Height="40"
                                        Margin="20,0,0,0"/>

                                    <TextBlock
                                        Width="100"
                                        Height="40"
                                        Margin="10,0,0,0"
                                        TextAlignment="Left"/>

                                    <TextBlock
                                        Width="70"
                                        Height="40"
                                        Margin="20,0,0,0"
                                        TextAlignment="Center"/>

                                </StackPanel>

                                <!-- Layout para una cancion (copiar en C#) -->

                            </ScrollViewer>

                            <!-- Contenedor de Canciones -->

                        </Grid>

                        <!-- Poner aca el grid que saque :v-->

                    </Border>

                    <!-- Recuadro Central Top -->

                    <!-- Recuadro Derecha Top -->

                    <Border
                        Grid.Column="2"
                        Margin="10,0,10,0"
                        CornerRadius="20"
                        Background="#B22E3752">



                    </Border>

                    <!-- Recuadro Derecha Top -->

                </Grid>

                <!-- Recuadros de abajo: mismo esquema de columnas proporcionales -->

                <Grid Grid.Row="2" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2.3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recuadro Izquierda Bot -->

                    <Border
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        Background="#B22E3752"
                        CornerRadius="20">



                    </Border>

                    <!-- Recuadro Izquierda Bot -->

                    <!-- Recuadro Central Bot -->

                    <Border
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Background="#B22E3752"
                        CornerRadius="20">



                    </Border>

                    <!-- Recuadro Central Bot -->

                    <!-- Recuadro Derecha Bot -->

                    <Border
                        Grid.Column="2"
                        Margin="10,0,10,0"
                        Background="#B22E3752"
                        CornerRadius="20">



                    </Border>

                    <!-- Recuadro Derecha Bot -->

                </Grid>

            </Grid>

        </Border>

        <!-- Cuerpo Principal -->

    </Grid>

</Window>
