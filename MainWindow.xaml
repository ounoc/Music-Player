            </ScrollViewer>

        </Grid>

        <!-- Panel Derecha -->
        <StackPanel
            Width="235"
            HorizontalAlignment="Left" Margin="1355,100,0,100"
            Background="#7F0B1129">


            <TextBlock x:Name="Music_Path" 
                   Foreground="White"
                   Text="Path: None" 
                   Background="#FF1D3D61"
                   Margin="0,5,0,0" 
                   Width="223" TextWrapping="Wrap" 
                   TextAlignment="Center"
                   MinHeight="20"
                   FontFamily="Nunito"/>

            <Button x:Name="Path_Button" Width="100"  
                    Height="30"
                    Content="Choose Path"
                    Margin="0,10,0,0"
                    Click="BtnSeleccionarCarpeta" IsEnabled="False"
                    FontFamily="Nunito"/>

            <TextBlock Text="Songs Assignation Mode" 
                       Foreground="White" 
                       TextAlignment="Center" 
                       Margin="0,5,0,0"
                       FontFamily="Nunito"/>

            <StackPanel 
                Orientation="Horizontal"
                VerticalAlignment="Center" HorizontalAlignment="Center">

                <ToggleButton
                    x:Name="Manual_Toggle_Button"
                    Width="50"
                    Height="30"
                    Content="Manual"
                    Margin="10"
                    Click="toggleButtons"
                    FontFamily="Nunito"/>

                <ToggleButton
                    x:Name="Auto_Toggle_Button"
                    Width="50"
                    Height="30"
                    Content="Auto"
                    Margin="10"
                    Click="toggleButtons"
                    FontFamily="Nunito"/>

            </StackPanel>

        </StackPanel>

        <!-- Panel Inferior -->
        <StackPanel
            Width="1090"
            HorizontalAlignment="Center" Margin="0,810,0,10"
            Background="#7F0B1129"
            Orientation="Vertical">
 
        </StackPanel>

        <Border x:Name="Alerta_Canciones"
                VerticalAlignment="Bottom"
                Background="#B2000000"
                Visibility="Visible"
                Width="1600"
                Height="870">

            <Grid>

                <Rectangle Fill="#80000000"
                    Width="1600"
                    Height="870"
                    MouseDown="HideAlertBtn"/>

                <!-- Opciones -->

                <StackPanel>
                    
                    
                    
                </StackPanel>
                
                <!-- Opciones -->

                <!-- Agregar Canciones -->

                <StackPanel
                    Background="#990F1A24"
                    Width="400"
                    Height="500"
                    Visibility="Hidden">

                    <TextBlock Text="Want to add:"
                               Foreground="White" 
                               TextAlignment="Center" 
                               FontSize="32" 
                               Margin="0,10,0,0" FontFamily="Nunito"/>

                    <TextBlock Width="350"
                               Height="200"
                               Foreground="White"
                               x:Name="SongTitle" TextAlignment="Center" 
                               FontSize="24" HorizontalAlignment="Center"
                               FontFamily="Nunito" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button Width="100"
                                Height="30"
                                Margin="10"
                                Content="Yes" 
                                Click="addSongs"
                                FontFamily="Nunito"/>

                        <Button Width="100"
                                Height="30"
                                Margin="10"
                                Content="No"
                                Click="declineSongs"
                                FontFamily="Nunito"/>

                    </StackPanel>

                </StackPanel>

                <!-- Agregar Canciones -->

            </Grid>

        </Border>

