<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        mc:Ignorable="d"
        Width="800" Height="400"
        MinWidth="1200" MinHeight="900"
        MaxWidth="1200" MaxHeight="900"
        Background="Black" 
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Grid>

        <!-- Barra Superior -->
        <Border Width="1200"
        Height="900"
        Background="Black"
        Margin="10"/>

        <Border Width="1200"
                Height="30"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#0EA5E9"
                MouseDown="Border_MouseDown">

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Width="60"
                        Height="30">

                <Button Width="20"
                        Height="20"
                        Margin="7, 0"
                        Content="___"
                        Click="Minimize"/>

                <Button Width="20"
                        Height="20"
                        Content="X"
                        Click="CloseApp"/>

            </StackPanel>

        </Border>

        <!-- Cuerpo Principal -->
        <Border
            Width="1200"
            Height="870"
            Background="#1E293B"
            VerticalAlignment="Bottom"/>

        <!-- Panel Izquierda -->
        <StackPanel
            Width="235"
            HorizontalAlignment="Left" Margin="10,100,0,100"
            Background="#7F0B1129">

        </StackPanel>

        <!-- Panel Central -->

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Width="700"
                      Height="700">

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Vertical"
                Width="690"
                Height="700"
                Background="#7F020308">

                <!-- Elementos -->

                <TextBox Width="300"
                         Height="30"
                         Margin="10"
                         FontFamily="Nunito" FontSize="24"/>

                <TextBlock x:Name="Canciones_Temporal" 
                       Text="No songs aviable. Select a path"
                       Width="500" 
                       Height="620"
                       MaxHeight="600"
                       Foreground="White" 
                       TextWrapping="Wrap" TextAlignment="Center"
                       FontFamily="Nunito" FontSize="18"/>

            </StackPanel>

        </ScrollViewer>

        <!-- Panel Derecha -->
        <StackPanel
            Width="235"
            HorizontalAlignment="Left" Margin="955,100,0,100"
            Background="#7F0B1129">


            <TextBlock x:Name="Music_Path" 
                   Foreground="White"
                   Text="Path: None" 
                   Background="#FF1D3D61"
                   Margin="0,5,0,0" 
                   Width="223" TextWrapping="Wrap" 
                   TextAlignment="Center"
                   MinHeight="20"
                   FontFamily="Nunito"/>

            <Button x:Name="Path_Button" Width="100"  
                    Height="30"
                    Content="Choose Path"
                    Margin="0,10,0,0"
                    Click="BtnSeleccionarCarpeta" IsEnabled="False"
                    FontFamily="Nunito"/>

            <TextBlock Text="Songs Assignation Mode" 
                       Foreground="White" 
                       TextAlignment="Center" 
                       Margin="0,5,0,0"
                       FontFamily="Nunito"/>

            <StackPanel 
                Orientation="Horizontal"
                VerticalAlignment="Center" HorizontalAlignment="Center">

                <ToggleButton
                    x:Name="Manual_Toggle_Button"
                    Width="50"
                    Height="30"
                    Content="Manual"
                    Margin="10"
                    Click="toggleButtons"
                    FontFamily="Nunito"/>

                <ToggleButton
                    x:Name="Auto_Toggle_Button"
                    Width="50"
                    Height="30"
                    Content="Auto"
                    Margin="10"
                    Click="toggleButtons"
                    FontFamily="Nunito"/>

            </StackPanel>

        </StackPanel>

        <!-- Panel Inferior -->
        <StackPanel
            Width="690"
            HorizontalAlignment="Center" Margin="0,810,0,10"
            Background="#7F0B1129"
            Orientation="Vertical">
 
        </StackPanel>

        <!-- Agregar Canciones -->

        <Border x:Name="Alerta_Canciones"
        Width="1200"
        Height="870"
        VerticalAlignment="Bottom"
        Background="#B2000000"
        Visibility="Hidden">

            <Grid>

                <Rectangle Fill="#80000000"
                    Width="1200"
                    Height="870"
                    MouseDown="HideAlertBtn"/>

                <StackPanel
                    Background="#990F1A24"
                    Width="400"
                    Height="500">

                    <TextBlock Text="Want to add:"
                               Foreground="White" 
                               TextAlignment="Center" 
                               FontSize="32" 
                               Margin="0,10,0,0" FontFamily="Nunito"/>

                    <TextBlock Width="350"
                               Height="200"
                               Foreground="White"
                               x:Name="SongTitle" TextAlignment="Center" 
                               FontSize="24" HorizontalAlignment="Center"
                               FontFamily="Nunito" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                        <Button Width="100"
                                Height="30"
                                Margin="10"
                                Content="Yes" 
                                Click="addSongs"
                                FontFamily="Nunito"/>

                        <Button Width="100"
                                Height="30"
                                Margin="10"
                                Content="No"
                                Click="declineSongs"
                                FontFamily="Nunito"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>
