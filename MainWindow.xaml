                    Width="1090"
                    Height="700"
                    Orientation="Horizontal">

                    <Rectangle  x:Name="Lugar"
                                Fill="#33000000"
                                Width="50" 
                                Height="650"
                                Margin="25,0,0,0"/>

                    <Rectangle  x:Name="Titulo"
                                Fill="#33000000"
                                Width="400" 
                                Height="650"
                                Margin="25,0,0,0"/>

                    <Rectangle  x:Name="Album"
                                Fill="#33000000"
                                Width="200" 
                                Height="650"
                                Margin="25,0,0,0"/>

                    <Rectangle  x:Name="Artist"
                                Fill="#33000000"
                                Width="180" 
                                Height="650"
                                Margin="25,0,0,0"/>

                    <Rectangle  x:Name="Duracion"
                                Fill="#33000000"
                                Width="100" 
                                Height="650"
                                Margin="25,0,0,0"/> 

                </StackPanel>

            </Border>

            <ScrollViewer 
                Width="1090"
                Height="650">

                <!-- ESTO SE TIENE QUE PODER REPLICAR MEDIANTE C# -->

